# Copy to .env and fill in. The scripts load it themselves, so there's no need to source it.

# Your Anthropic API key. It's used by the agent on Deep Agents and Claude Managed Agents,
# by the simulated user (benchmark/human.py), and by ant when
# agents/claude-managed-agents/apply.py runs it. TrueForge needs the same key, entered
# in its UI under Settings → Models.
ANTHROPIC_API_KEY=

# The MCP server's public address through ngrok (see the README, section 1), with /mcp
# on the end. Claude Managed Agents runs in Anthropic's cloud, so it always needs this.
# If you leave it empty, TrueForge and Deep Agents use http://localhost:8800/mcp instead
# (TrueForge then needs OUTBOUND_URL_ALLOWED_HOSTS; see the README, section 2).
MCP_PUBLIC_URL=

# Where your TrueForge server runs. The default is right unless you changed TrueForge's port.
TRUEFORGE_BASE_URL=http://localhost:8790
